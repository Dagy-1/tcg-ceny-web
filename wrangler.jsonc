{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcg-ceny-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DISCORD_REDIRECT_URI": "https://tcg-ceny-web.tcg-ceny.workers.dev/api/auth/discord/callback",
    "GOOGLE_REDIRECT_URI": "https://tcg-ceny-web.tcg-ceny.workers.dev/api/auth/google/callback"
  },
  "routes": [
    {
      "pattern": "tcgceny.cz/*",
      "zone_name": "tcgceny.cz"
    },
    {
      "pattern": "www.tcgceny.cz/*",
      "zone_name": "tcgceny.cz"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcg-ceny-portfolio",
      "database_id": "df3735ed-1378-4057-8e26-72ab48e12607",
      "migrations_dir": "migrations"
    }
  ]
}
