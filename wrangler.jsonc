{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcg-ceny-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DISCORD_REDIRECT_URI": "https://tcg-ceny-web.p-mladek99.workers.dev/api/auth/discord/callback",
    "GOOGLE_REDIRECT_URI": "https://tcg-ceny-web.p-mladek99.workers.dev/api/auth/google/callback",
    "CENTRAL_API_BASE_URL": "https://tcg-ceny-api.onrender.com",
    "PORTFOLIO_DATA_SOURCE": "central"
  },
  "routes": [
    {
      "pattern": "tcgceny.cz/*",
      "zone_name": "tcgceny.cz"
    },
    {
      "pattern": "www.tcgceny.cz/*",
      "zone_name": "tcgceny.cz"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcg-ceny-portfolio",
      "database_id": "f20537d7-0e2f-4bfc-8b98-e8bb197f32ba",
      "migrations_dir": "migrations"
    }
  ]
}
