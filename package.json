{
  "name": "tcg-ceny-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/generate-web-catalog.mjs && node scripts/generate-web-portfolio.mjs && wrangler d1 migrations apply tcg-ceny-portfolio --local --config wrangler.jsonc",
    "dev": "vite build && vite preview --host localhost --port 3100 --strictPort",
    "prebuild": "node scripts/generate-web-catalog.mjs && node scripts/generate-web-portfolio.mjs",
    "build": "next build --webpack",
    "predeploy": "node scripts/generate-web-catalog.mjs && node scripts/generate-web-portfolio.mjs",
    "deploy": "vite build && wrangler deploy",
    "pretest": "node scripts/generate-web-catalog.mjs && node scripts/generate-web-portfolio.mjs",
    "test": "next build --webpack && node --experimental-strip-types --test tests/static-export.test.mjs",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
