{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcg-ceny-web-test",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DISCORD_REDIRECT_URI": "https://tcg-ceny-web-test.p-mladek99.workers.dev/api/auth/discord/callback",
    "GOOGLE_REDIRECT_URI": "https://tcg-ceny-web-test.p-mladek99.workers.dev/api/auth/google/callback",
    "CENTRAL_API_BASE_URL": "https://tcg-ceny-api.onrender.com",
    "PORTFOLIO_DATA_SOURCE": "central"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcg-ceny-portfolio-test",
      "database_id": "acc4cd84-5704-4237-a059-a236e84927d3",
      "migrations_dir": "migrations"
    }
  ]
}
